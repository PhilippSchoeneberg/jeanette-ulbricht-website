# Copy this file to .env and fill in the values. Never commit .env (it is in .gitignore).
#
# Local development: copy as is (APP_ENV=development, empty SMTP_HOST = contact messages are
# printed to the server console).
# Server (Docker): fill in the mail settings; compose.yaml always runs the container with
# APP_ENV=production, which refuses to start without a mail server.

# "development" locally, "production" on the server (also the default when unset).
# Development: without SMTP_HOST, contact messages are printed to the server console instead of
# being sent, and the API docs are at /api/docs. Production: a mail server is required (the app
# refuses to start without one) and the API docs are off.
APP_ENV=development

# Mail server for the contact form. Leave SMTP_HOST empty for local development.
# Example: SMTP_HOST=smtp.example.com
SMTP_HOST=
# 587 for starttls, 465 for ssl (default depends on SMTP_SECURITY).
SMTP_PORT=
# starttls (default), ssl or none
SMTP_SECURITY=starttls
# Example: SMTP_USERNAME=website@example.com
SMTP_USERNAME=
# The mail account's password (or app password).
SMTP_PASSWORD=

# Where contact form messages are delivered (Jeanette's address).
# Example: CONTACT_RECIPIENT=kontakt@example.com
CONTACT_RECIPIENT=
# The From address of those messages. Must be an address the mail server may send from,
# usually the SMTP account itself. Visitors' addresses are set as Reply-To.
# Example: CONTACT_SENDER=website@example.com
CONTACT_SENDER=

# Docker only, optional: which addresses may send X-Forwarded-For / X-Forwarded-Proto (the Caddy
# proxy). Default: the private address ranges Docker uses. To trust only the "web" network, set its
# subnet (shown by: docker network inspect web --format '{{(index .IPAM.Config 0).Subnet}}').
# Example: FORWARDED_ALLOW_IPS=172.18.0.0/16
# FORWARDED_ALLOW_IPS=
