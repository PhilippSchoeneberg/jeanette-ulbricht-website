# Copy this file to .env and fill in the values. Never commit .env.

# "development" locally, "production" on the server (also the default when unset).
# Development: without SMTP_HOST, contact messages are printed to the server console instead of
# being sent, and the API docs are at /api/docs. Production: a mail server is required (the app
# refuses to start without one) and the API docs are off.
APP_ENV=development

# Mail server for the contact form. Leave SMTP_HOST empty for local development.
SMTP_HOST=
# 587 for starttls, 465 for ssl (default depends on SMTP_SECURITY).
SMTP_PORT=
# starttls (default), ssl or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Where contact form messages are delivered (Jeanette's address).
CONTACT_RECIPIENT=
# The From address of those messages. Must be an address the mail server may send from,
# usually the SMTP account itself. Visitors' addresses are set as Reply-To.
CONTACT_SENDER=
